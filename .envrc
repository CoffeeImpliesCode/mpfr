# direnv integration for the MPFR Zig SDK.
#
# Canonical development is `devenv shell`. This file makes `direnv allow` in
# this directory enter the same environment, so an editor that shells out here
# gets the pinned compiler without anyone remembering to type the command.
#
# `use devenv` supports the same options as `devenv shell`. To silence the
# output, use `--quiet`. There is no `--dotfile` flag: the devenv in this
# workspace is 2.4.1 and its help does not list one, so nothing here passes a
# flag that does not exist.

export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv