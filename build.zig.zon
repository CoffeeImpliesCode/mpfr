// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Fork-authored. `FORK-LICENSE.md` records the owner's authorization of that
// grant and why it matches MPFR's own primary upstream terms.

.{
    .name = .mpfr,
    .version = "4.2.2",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x315544a3cf639019,

    // The self-contained GMP snapshot required by the shared fork contract.
    // It must be the parent's verified GMP package, including its own
    // build.zig.zon, and it must declare the name `gmp` and expose
    // `dep.artifact("gmp")`. `-Dsystem=gmp` selects an installed GMP instead.
    .dependencies = .{
        .gmp = .{
            .path = "vendor/gmp",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "root.zig",
        // `build.zig` imports `zig/config_gen.zig`; a package that does not
        // ship it cannot resolve the import when it is fetched by hash.
        "zig",
        // The runtime route: `runtime/graph.zig` is imported by `build.zig` for
        // the `-Druntime=true` route and the loader core it names is what that
        // route resolves symbols through. A fetched package that did not ship
        // the directory could not resolve the import.
        "runtime",
        "fork",
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream's own sources and licence terms, kept verbatim.
        "src",
        "doc",
        "examples",
        "tests",
        "tools",
        "tune",
        "m4",
        "other",
        "COPYING",
        "COPYING.LESSER",
        "AUTHORS",
        "BUGS",
        "ChangeLog",
        "INSTALL",
        "NEWS",
        "PATCHES",
        // `build.zig` embeds the pkg-config template to install `mpfr.pc`, so
        // a fetched package that did not ship it could not resolve the embed.
        "mpfr.pc.in",
        "README",
        "TODO",
        "VERSION",
        "Makefile.am",
        "acinclude.m4",
        "autogen.sh",
        "configure.ac",
        "codespell.exclude",
        "codespell.ignore",
        "libtool-tcc-rpath.patch",
        "libtool-tcc-wl.patch",
        "version-ext.sh",
        ".mailmap",
        ".gitignore",
        "vendor/gmp",
        ".github",
        // Fork provenance and divergence records.
        "UPSTREAM.md",
        // The per-file SHA-256 baseline for every upstream byte this package
        // carries, and the script that verifies it from the package root. Both
        // are needed by a fetched package for the provenance claim to be
        // checkable rather than only assertable.
        "UPSTREAM-BASELINE.sha256",
        "check-upstream-baseline.sh",
        "CHANGELOG.md",
        "NOTICE.md",
        "FORK-NOTES.md",
        "README.zig.md",
        // The fork README (written by this project's provenance role) and the
        // packaging entry points it documents. They are listed here so a
        // fetched or installed package carries the same provenance and
        // packaging surface the build graph and its documentation describe;
        // every one of them must exist, because a missing `.paths` entry is a
        // package resolution failure.
        //
        // `flake.lock` exists in this tree, so it is named: the workspace's
        // integration owner writes it, and a package that shipped `flake.nix`
        // without it would re-resolve its own input on first evaluation instead
        // of using the recorded one. `devenv.lock` is absent from this tree and
        // is therefore not named; naming it would be a resolution failure.
        "README.md",
        "README.upstream.md",
        "FORK-LICENSE.md",
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
