.{
    .name = .mpfr,
    .version = "4.2.2",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x315544a3cf639019,

    // Bundled GMP is the default; `-fsys=gmp` selects an installed library.
    .dependencies = .{
        .gmp = .{
            .url = "git+https://github.com/CoffeeImpliesCode/gmp?ref=v6.3.0#c124ccbaf2072c438a7e8def5addc628c65ab74e",
            .hash = "gmp-6.3.0-FVVS2nj8CwF5oxyvYkR6LzJuPs5MgvaDC7zf-xWIJX--",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "root.zig",
        // Required by `build.zig`'s configuration import.
        "zig",
        // Runtime-loader sources.
        "runtime",
        "fork",
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream sources and licence terms.
        "src",
        "doc",
        "examples",
        "tests",
        "tools",
        "tune",
        "m4",
        "other",
        "COPYING",
        "COPYING.LESSER",
        "AUTHORS",
        "BUGS",
        "ChangeLog",
        "INSTALL",
        "NEWS",
        "PATCHES",
        // Embedded by `build.zig` to generate `mpfr.pc`.
        "mpfr.pc.in",
        "README",
        "TODO",
        "VERSION",
        "Makefile.am",
        "acinclude.m4",
        "autogen.sh",
        "configure.ac",
        "codespell.exclude",
        "codespell.ignore",
        "libtool-tcc-rpath.patch",
        "libtool-tcc-wl.patch",
        "version-ext.sh",
        ".mailmap",
        ".gitignore",
        // Fork provenance records.
        "UPSTREAM.md",
        // Baseline and script for upstream-byte provenance checks.
        "UPSTREAM-BASELINE.sha256",
        "check-upstream-baseline.sh",
        "CHANGELOG.md",
        "NOTICE.md",
        "FORK-NOTES.md",
        "README.zig.md",
        "README.md",
        "README.upstream.md",
        "FORK-LICENSE.md",
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
